{
  "name": "combo-clip-composer",
  "version": "0.0.1",
  "description": "Combo Clip Composer is a command-line tool that allows users to stitch together videos and inputs based on text inputs. ",
  "main": "main.js",
  "scripts": {
    "clean": "rm -rf ./artifacts/ && mkdir artifacts",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "editor:dev": "electron editor/main.js",
    "editor:build": "electron-builder --dir"
  },
  "engines": {
    "node": ">=10.0.0",
    "npm": ">=6.0.0"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.0.0",
    "canvas": "^2.11.2",
    "ffmpeg-extract-frames": "^2.0.2",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.0",
    "image-size": "^1.0.2",
    "uuid": "^9.0.0",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.4.3"
  },
  "build": {
    "appId": "com.comboclipcomposer.editor",
    "productName": "Combo Clip Composer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "editor/**/*",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "editor/main.js"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/@ffprobe-installer/**/*"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "typings": "index.d.ts",
  "author": "dabruhce",
  "license": "MIT"
}
